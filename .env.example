# All variables are optional. See README.md > Environment variables.

# Base URL for the ranking/history REST API. The MSW mocks intercept this path.
VITE_API_BASE_URL=/api

# Set to "false" to disable the MSW mock worker (e.g. when pointing to a real backend).
VITE_ENABLE_MOCKS=true

# Axios request timeout in milliseconds.
VITE_API_TIMEOUT_MS=8000
